# Local: leave as /api/backend (Next rewrite → uvicorn :8000)
NEXT_PUBLIC_API_URL=/api/backend

# Production (Vercel): full Railway HTTPS origin, no trailing slash
# NEXT_PUBLIC_API_URL=https://hd-biohack-api-production.up.railway.app

NEXT_PUBLIC_ENFORCE_PAYWALL=false

# Dev user switcher / paywall toggles in Header — auto-on in `next dev`.
# Leave unset/false on Vercel so real users never see Dev chrome.
NEXT_PUBLIC_SHOW_DEV_CONTROLS=false
