# --- Database ---
# Leave empty for local SQLite (default). Set for Supabase/Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth (Google OAuth) — optional for V1; UI shows stub button
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- LLM (optional) ---
# Leave blank for deterministic protocols only
LLM_PROVIDER=          # xai | openai | anthropic
LLM_API_KEY=

# --- App ---
NOMINATIM_USER_AGENT=hd-biohack-v1/1.0 (your-email@example.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENFORCE_PAYWALL=false

# Frontend (copy to frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_ENFORCE_PAYWALL=false
