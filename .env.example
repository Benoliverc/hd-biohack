# --- Database ---
# Local / Railway v1: leave empty for SQLite.
# On Railway, also set SQLITE_PATH=/data/hd_biohack.db and mount a volume at /data
# so charts/inventory survive redeploys.
DATABASE_URL=
SQLITE_PATH=

# Optional Postgres later (Railway Postgres or Supabase). When set, SQLite is unused.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# (postgres:// and postgresql:// are normalized to postgresql+psycopg://)

# Supabase Auth (Google OAuth) — optional for V1; UI shows stub button
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- LLM (optional) ---
# Leave blank for deterministic protocols only
LLM_PROVIDER=          # xai | openai | anthropic
LLM_API_KEY=

# --- App ---
NOMINATIM_USER_AGENT=hd-biohack-v1/1.0 (your-email@example.com)
# Comma-separated browser origins. Alias: ALLOWED_ORIGINS
# Local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (add every Vercel URL + custom domain):
# CORS_ORIGINS=https://hd-biohack.vercel.app,https://www.yourdomain.com
ENFORCE_PAYWALL=false
# Seed Dev Free / Dev Pro users when DB is empty (needed until Google auth ships)
SEED_DEV_USERS=true

# --- Frontend (copy relevant keys to frontend/.env.local or Vercel env) ---
# Local: leave unset or /api/backend so the browser uses the Next rewrite.
# Do NOT set http://127.0.0.1:8000 when using a public tunnel.
# NEXT_PUBLIC_API_URL=/api/backend
# Production Vercel: Railway HTTPS origin (no trailing slash)
# NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
# NEXT_PUBLIC_ENFORCE_PAYWALL=false
# NEXT_PUBLIC_SHOW_DEV_CONTROLS=false
